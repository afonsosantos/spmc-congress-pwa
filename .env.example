# Copy this file to .env and fill in real values. Never commit .env.

# --- Pretix (registration / ticketing) ---
PRETIX_BASE_URL=https://pretix.congresso-spmc.com
PRETIX_ORGANIZER=spmc
PRETIX_EVENT=congresso2027
# Server-side only. Never exposed to the frontend.
PRETIX_API_TOKEN=

# --- Pretalx (program / schedule) ---
PRETALX_BASE_URL=https://pretalx.congresso-spmc.com
PRETALX_EVENT=congresso2027

# --- Database ---
# Used by the app container. docker-compose derives this from the values
# below when using the bundled postgres service.
POSTGRES_DB=spmc_congresso
POSTGRES_USER=spmc
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://spmc:change-me@postgres:5432/spmc_congresso

# --- Sessions ---
# Long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Web Push (optional; app works without it) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:geral@congresso-spmc.com

# --- Admin (small built-in announcements/content admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Server ---
NODE_ENV=production
PORT=3000
# Comma-separated list of allowed origins for the API (the PWA's own origin).
CORS_ORIGIN=https://app.congresso-spmc.com
